# NestScout Backend Configuration Example
# Copy to .env for local overrides (never commit real keys).

PORT=8080

# Set to true for deterministic zero-key local planning, or false to call the remote structured endpoint.
A2UI_MOCK_MODE=true

# Required only when A2UI_MOCK_MODE=false
GEMINI_API_KEY=

# Remote structured output endpoint settings
PLANNER_API_BASE_URL=https://generativelanguage.googleapis.com
PLANNER_MODEL_ID=gemini-2.5-flash

# Comma-separated HTTPS image host allowlist
ALLOWED_IMAGE_HOSTS=images.unsplash.com,cdn.nestscout.example
